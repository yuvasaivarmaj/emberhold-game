{
  "name": "emberhold-game",
  "private": true,
  "version": "0.1.0",
  "description": "The Blood of Emberhold - a first-person open-world browser game",
  "type": "module",
  "scripts": {
    "bake": "esbuild tools/bake-world.ts --bundle --platform=node --format=esm --outfile=tools/.bake.mjs --log-level=warning && node tools/.bake.mjs",
    "predev": "node tools/ensure-baked.mjs",
    "dev": "vite",
    "prebuild": "node tools/ensure-baked.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "stars": "node tools/build-stars.mjs"
  },
  "dependencies": {
    "@dgreenheck/ez-tree": "1.1.0",
    "@dimforge/rapier3d-compat": "0.21.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/three": "0.186.0",
    "esbuild": "^0.27.7",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}